VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Leave server-only values blank in this committed template. Supply real values
# through the deployment environment; use either the raw ingest token or hash.
SITEFINDER_MCP_TOKEN_SHA256=
SUPABASE_SECRET_KEY=
RESEARCH_AGENT_INGEST_TOKEN=
RESEARCH_AGENT_INGEST_TOKEN_SHA256=
# Tenant that owns runs the research worker starts on its own.
RESEARCH_AGENT_INGEST_TENANT_ID=
# pull-tender-notices: shared secret sent by the cron call as x-tender-pull-secret
# (set as a Supabase function secret and in Vault, never committed).
TENDER_PULL_SECRET=
# Optional overrides for the public tender feed hosts (testing only).
TENDER_FTS_BASE_URL=
TENDER_CF_BASE_URL=
