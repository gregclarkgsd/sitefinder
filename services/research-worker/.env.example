# Required private-data boundary. Use an absolute path on local, non-synced
# storage outside every Git repository and outside iCloud.
RESEARCH_PRIVATE_DATA_DIRECTORY=

# Read-only CRM access. Never commit real values.
ATTIO_API_TOKEN=
PIPEDRIVE_API_TOKEN=
PIPEDRIVE_API_DOMAIN=https://api.pipedrive.com

# Optional UK public-data source.
COMPANIES_HOUSE_API_KEY=

# Optional licensed people-data source. In this iCloud-backed workspace, supply
# the real value through the local process environment or a secret manager.
# Never place it in this file, iCloud, Git, run output, or browser storage.
APOLLO_API_KEY=

# Optional SiteFinder control-room progress feed. This is not a CRM write path.
RESEARCH_AGENT_INGEST_URL=
RESEARCH_AGENT_INGEST_TOKEN=

# Optional one-run queue consumer. The manifest and every path inside it must
# resolve beneath RESEARCH_PRIVATE_DATA_DIRECTORY.
RESEARCH_QUEUE_INPUT_MANIFEST=
RESEARCH_WORKER_ID=gsd-local-worker

# Identifies the crawler honestly in HTTP requests.
CRAWLER_CONTACT_URL=https://www.gsdecorating.com/

# Conservative defaults. These can be overridden per CLI run.
CRAWLER_MAX_PAGES=12
CRAWLER_MAX_PDFS=3
CRAWLER_DELAY_MS=800
CRAWLER_TIMEOUT_MS=12000
