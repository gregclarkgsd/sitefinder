{
  "name": "gsd-sales-enrichment",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Read-only, evidence-first enrichment for GSD London company and contact records.",
  "engines": {
    "node": ">=22.3.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "npm run typecheck && npm test",
    "enrich": "tsx src/cli.ts enrich",
    "reconcile": "tsx src/cli.ts reconcile",
    "snapshot:attio": "tsx src/cli.ts snapshot-attio",
    "snapshot:pipedrive": "tsx src/cli.ts snapshot-pipedrive",
    "test": "tsx --test test/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "cheerio": "1.2.0",
    "dotenv": "16.6.1",
    "pdf-parse": "2.4.5",
    "robots-parser": "3.0.1",
    "tldts": "7.4.9",
    "undici": "7.29.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.1.0",
    "tsx": "4.23.1",
    "typescript": "7.0.2"
  }
}
